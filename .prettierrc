{
    "plugins": ["@trivago/prettier-plugin-sort-imports"],
    "arrowParens": "always",
    "bracketSameLine": false,
    "trailingComma": "none",
    "bracketSpacing": true,
    "embeddedLanguageFormatting": "auto",
    "insertPragma": false,
    "jsxBracketSameLine": false,
    "jsxSingleQuote": true,
    "printWidth": 120,
    "semi": true,
    "singleQuote": true,
    "tabWidth": 4,
    "useTabs": false,
    "importOrderParserPlugins": ["typescript", "jsx", "decorators-legacy"],
    "importOrder": [
        "^(react/(.*)$)|^(react$)",
        "<THIRD_PARTY_MODULES>",
        "^../.*(?!\\.(c|le|sc)ss)$",
        "^[./].*(?<!\\.(c|le|sc)ss)$",
        "\\.(c|le|sc)ss$"
    ],
    "importOrderSortSpecifiers": true
}
